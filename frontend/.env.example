# Copy to .env.local and fill in for development or set in Netlify site settings

# Main platform domain for multi-tenant routing
NEXT_PUBLIC_PLATFORM_DOMAIN=withluna.tech

# FastAPI backend API URL
# Local: http://localhost:8000
# Koyeb: https://<your-app-name>.koyeb.app (or custom domain https://api.withluna.tech)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Better-Auth settings
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=luna_secret_auth_key_2026_super_secure_multi_tenant
