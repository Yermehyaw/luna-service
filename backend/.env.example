# Copy to .env and fill in. Never commit the real .env.

ENVIRONMENT=development
DEBUG=false
PORT=8000

# Database (PostgreSQL)
# Local: postgresql+asyncpg://luna_user:luna_password@localhost:5432/luna_db
# Cloud (e.g. Supabase, Neon, or Oracle VM Postgres):
DATABASE_URL=postgresql+asyncpg://postgres:xD8VBEi98L.LF/U@db.txozfuqspwkuqsjgspzl.supabase.co:5432/postgres?ssl=require
DATABASE_ECHO=false

# Redis (Upstash Serverless or Local Redis)
# Local: redis://localhost:6379
# Upstash: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=rediss://default:gQAAAAAAAwlJAAIgcDIzM2JlMzMyYjUxMGQ0ZWQ0YmQ3ZTNhZDU5ZTc0ZmM3MQ@tough-antelope-198985.upstash.io:6379


# Authentication (Better-Auth JWT verification)
BETTER_AUTH_SECRET=luna_secret_auth_key_2026_super_secure_multi_tenant
BETTER_AUTH_ALGORITHM=HS256

# Comma-separated CORS origins (wildcard subdomains *.withluna.tech are handled automatically by regex)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://withluna.tech,https://app.withluna.tech

# Clerk (optional legacy auth fallback)
CLERK_PEM_PUBLIC_KEY=
CLERK_ISSUER=

# --- AI Configuration ---
# Setting LUNA_MODAL_API_URL routes classifier & Qwen-3B chat completions to your Modal deployment.
# Deploy with: modal deploy Modal/modal_app.py
# Format: https://<workspace-name>--luna-ai-api.modal.run
LUNA_MODAL_API_URL=https://yermehyaw--luna-ai-api.us-east.modal.run

# If using independent/custom endpoints instead of unified Modal:
LUNA_CLASSIFIER_URL=
LUNA_MODEL_URL=https://router.huggingface.co/v1
LUNA_MODEL_API_KEY=
LUNA_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# OpenAI fallback (optional)
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=20.0
OPENAI_MAX_RETRIES=2

# --- Social Studio (Hexagonal Ports & Adapters) ---
DEFAULT_SOCIAL_PROVIDER=socialapi
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api
SOCIALAPI_AI_KEY=sapi_key_77a1c8a00002ef981fb051e636e559393fb0e6ef939b6e1df24e2ebe5badd4
SOCIALAPI_BASE_URL=https://api.social-api.ai/v1
POSTPROXY_API_KEY=
POSTPROXY_BASE_URL=https://api.postproxy.dev
