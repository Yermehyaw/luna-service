# Copy to .env and fill in. Never commit the real .env.

ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+asyncpg://luna_user:luna_password@localhost:5432/luna_db
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379

# Comma-separated. Tenant custom domains get added here as they go live.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Clerk (customer + staff auth)
CLERK_PEM_PUBLIC_KEY=
CLERK_ISSUER=
